      <column caption='parementer mapping' datatype='boolean' name='[Calculation_448389648346419202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;BANK SERVICES&apos; THEN [Product (group)] =&apos;BANK SERVICES&apos;&#13;&#10;WHEN &apos;CHECKING/SERVICES&apos; THEN [Product (group)] =&apos;CHECKING/SERVICES&apos;&#13;&#10;WHEN &apos;CREDIT CARD&apos; THEN [Product (group)] =&apos;CREDIT CARD&apos;&#13;&#10;WHEN &apos;MORTGAGES&apos; THEN [Product (group)] =&apos;MORTGAGES&apos;&#13;&#10;WHEN &apos;OTHERS&apos; THEN [Product (group)] =&apos;OTHERS&apos;&#13;&#10;WHEN &apos;ALL&apos;THEN [Product (group)] IN (&apos;BANK SERVICES&apos;,&apos;CHECKING/SERVICES&apos;,&apos;CREDIT CARD&apos;,&#13;&#10;&apos;MORTGAGES&apos;,&apos;OTHERS&apos;)&#13;&#10;END' />
      </column>
      <column caption='parameter selection' datatype='string' name='[Calculation_448389648348577795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = [Product (group)] THEN [Product (group)]END' />
      </column>
      <column caption='map taggle' datatype='string' name='[Calculation_624030033885380608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='product map selector' datatype='string' name='[Calculation_624030033885577217]' role='dimension' type='nominal'>
