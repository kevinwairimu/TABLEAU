      <aliases enabled='yes' />
      <column caption='no prev sale ' datatype='string' name='[% negative incre  (copy)_336362607382028309]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_336362607376896018]=&apos;no sales&apos; THEN &quot;NO PREVIOUS SALES&quot;&#13;&#10;END' />
      </column>
      <column caption='% negative incre ' datatype='string' name='[% positive incre (copy)_336362607380381716]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_336362607375171601] &lt; 0 THEN &quot;▼&quot;&#13;&#10;END' />
      </column>
      <column caption='CYTD ORDER LOD  ' datatype='integer' name='[CYTD PROFIT LOD  (copy)_336362607359336456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED: SUM(IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Order Quantity] END)}' />
      </column>
      <column caption='CYTD PROFIT LOD ' datatype='real' name='[CYTD SALES LOD (copy)_336362607354871812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED: SUM(IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Profit Per Order] END)}' />
      </column>
      <column caption='YTD SALES ' datatype='real' name='[CYTD SALES LOD (copy)_336362607365488655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Sales] END' />
      </column>
      <column caption='CYTD SALES LOD' datatype='real' name='[Calculation_336362607344021504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED: SUM(IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Sales] END)}' />
      </column>
      <column caption='YOYD SALES%' datatype='real' name='[Calculation_336362607347892226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_336362607344021504]-[YTD SALES LOD (copy)_336362607346356225])/[YTD SALES LOD (copy)_336362607346356225]' />
      </column>
      <column caption='YOY SALES MARGIN' datatype='string' name='[Calculation_336362607351222275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_336362607347892226]&gt;0 THEN &quot;▲&quot; ELSEIF  [Calculation_336362607347892226]&lt;0 THEN &quot;▼&quot; END' />
      </column>
      <column caption='%DIFFERENCE' datatype='real' name='[Calculation_336362607375171601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([CYTD SALES LOD (copy)_336362607365488655])-SUM([YTD SALES  (copy)_336362607374757904]))/SUM([YTD SALES  (copy)_336362607374757904])' />
      </column>
      <column caption='SALES MARGIN' datatype='string' name='[Calculation_336362607376896018]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([CYTD SALES LOD (copy)_336362607365488655])-sum([YTD SALES  (copy)_336362607374757904])&lt; 0 then &quot;less than py&quot;&#13;&#10;ELSEIF SUM([CYTD SALES LOD (copy)_336362607365488655])-sum([YTD SALES  (copy)_336362607374757904])&gt; 0 then &quot;morethan py&quot;&#13;&#10;ELSEIF ISNULL(sum([YTD SALES  (copy)_336362607374757904])) THEN &quot;no sales&quot;&#13;&#10;END' />
      </column>
      <column caption='% positive incre' datatype='string' name='[Calculation_336362607379173395]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_336362607375171601] &gt; 0 THEN &quot;▲&quot;&#13;&#10;END' />
      </column>
